{
  "manifest_version": 3,
  "name": "👂 Escuta Beat",
  "version": "3.4.0",
  "description": "Monitor de resultados - v3.4 VISION: foto->dados (captura 1 frame/giro + OCR no servidor). v3.3 AUTO-START: detecta a roleta sozinha (zero-upload) via provider_router + manifests empacotados",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["deal_capture.js"],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["providers/*.json"],
      "matches": ["<all_urls>"]
    }
  ]
}