{
  "title": "Roleta Cloud — Overview",
  "uid": "roleta-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "Adaptive state keys", "gridPos": {"x":0,"y":0,"w":4,"h":4},
      "targets": [{"expr": "roleta_adaptive_state_keys_count"}],
      "fieldConfig": {"defaults":{"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"green","value":5}]}}} },
    { "id": 2, "type": "stat", "title": "Sigmoid populated", "gridPos": {"x":4,"y":0,"w":4,"h":4},
      "targets": [{"expr": "roleta_sigmoid_off_populated"}] },
    { "id": 3, "type": "stat", "title": "state.json age (s)", "gridPos": {"x":8,"y":0,"w":4,"h":4},
      "targets": [{"expr": "roleta_state_file_age_seconds"}],
      "fieldConfig": {"defaults":{"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":120},{"color":"red","value":300}]}}} },
    { "id": 4, "type": "stat", "title": "Kill pulls total", "gridPos": {"x":12,"y":0,"w":4,"h":4},
      "targets": [{"expr": "roleta_kill_pulls_total"}] },
    { "id": 5, "type": "stat", "title": "Last spin age (s)", "gridPos": {"x":16,"y":0,"w":4,"h":4},
      "targets": [{"expr": "roleta_seconds_since_last_spin"}],
      "fieldConfig": {"defaults":{"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":120},{"color":"red","value":300}]}}} },
    { "id": 10, "type": "timeseries", "title": "Recent accuracy", "gridPos": {"x":0,"y":4,"w":12,"h":8},
      "targets": [
        {"expr": "roleta_recent_acc_cw", "legendFormat": "CW"},
        {"expr": "roleta_recent_acc_ccw", "legendFormat": "CCW"}
      ],
      "fieldConfig": {"defaults":{"min":0,"max":1,"unit":"percentunit"}} },
    { "id": 11, "type": "timeseries", "title": "Kill pulls (/min)", "gridPos": {"x":12,"y":4,"w":12,"h":8},
      "targets": [{"expr": "rate(roleta_kill_pulls_total[5m]) * 60", "legendFormat": "pulls/min"}] },
    { "id": 20, "type": "timeseries", "title": "Outbox published (/s)", "gridPos": {"x":0,"y":12,"w":12,"h":8},
      "targets": [{"expr": "rate(outbox_hook_published_total[5m])"}] },
    { "id": 21, "type": "timeseries", "title": "state.json size (bytes)", "gridPos": {"x":12,"y":12,"w":12,"h":8},
      "targets": [{"expr": "roleta_state_file_size_bytes"}] },
    { "id": 30, "type": "timeseries", "title": "Batch tune — pullbacks por direção", "gridPos": {"x":0,"y":20,"w":12,"h":8},
      "targets": [
        {"expr": "roleta_batch_tune_pullback_cw_total", "legendFormat": "CW"},
        {"expr": "roleta_batch_tune_pullback_ccw_total", "legendFormat": "CCW"}
      ] },
    { "id": 31, "type": "timeseries", "title": "Batch tune — última ação delta", "gridPos": {"x":12,"y":20,"w":12,"h":8},
      "targets": [
        {"expr": "roleta_batch_tune_last_delta_cw", "legendFormat": "CW Δ"},
        {"expr": "roleta_batch_tune_last_delta_ccw", "legendFormat": "CCW Δ"}
      ],
      "fieldConfig": {"defaults":{"min":-1,"max":1}} },
    { "id": 32, "type": "timeseries", "title": "KILL v4 thresholds (c4)", "gridPos": {"x":0,"y":28,"w":12,"h":8},
      "targets": [
        {"expr": "roleta_kill_threshold_c4_cw", "legendFormat": "c4_thr CW"},
        {"expr": "roleta_kill_threshold_c4_ccw", "legendFormat": "c4_thr CCW"}
      ],
      "fieldConfig": {"defaults":{"min":0.15,"max":0.40,"unit":"percentunit"}} },
    { "id": 33, "type": "timeseries", "title": "KILL v4 thresholds (sda)", "gridPos": {"x":12,"y":28,"w":12,"h":8},
      "targets": [
        {"expr": "roleta_kill_threshold_sda_cw", "legendFormat": "sda_thr CW"},
        {"expr": "roleta_kill_threshold_sda_ccw", "legendFormat": "sda_thr CCW"}
      ],
      "fieldConfig": {"defaults":{"min":1,"max":6}} },
    { "id": 34, "type": "stat", "title": "Batch runs total CW", "gridPos": {"x":0,"y":36,"w":6,"h":4},
      "targets": [{"expr": "roleta_batch_tune_runs_cw_total"}] },
    { "id": 35, "type": "stat", "title": "Batch runs total CCW", "gridPos": {"x":6,"y":36,"w":6,"h":4},
      "targets": [{"expr": "roleta_batch_tune_runs_ccw_total"}] },
    { "id": 36, "type": "stat", "title": "Pending CW", "gridPos": {"x":12,"y":36,"w":6,"h":4},
      "targets": [{"expr": "roleta_batch_tune_pending_cw"}] },
    { "id": 37, "type": "stat", "title": "Pending CCW", "gridPos": {"x":18,"y":36,"w":6,"h":4},
      "targets": [{"expr": "roleta_batch_tune_pending_ccw"}] }
  ]
}
