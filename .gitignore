# ===================================================
# Roleta Cloud - .gitignore
# ===================================================

# ----------------- Python -----------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
.eggs/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ----------------- IDE --------------------
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# ----------------- Logs -------------------
*.log
logs/

# ----------------- Secrets ----------------
.env
.env.*
my_key.pub
*.pem
*.key
secrets/
firebase-credentials.json
*.credentials.json
# B2 / WAL-G credentials (NUNCA commitar)
b2_application_key
b2_*_key
wal-g.env
*.b2.env
# WAL-G binário (download externo, ~65MB)
wal-g/wal-g
wal-g/*.tar.gz
# Grafana / observability secrets
grafana_token
grafana-agent/config.yml
*.glc.token

# ----------------- Dados de Produção (Danger Zone) -
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
log_de_apostas*.txt
roleta_dados_salvos.json
*-datalake.db

# ----------------- Agent Context Logs (Secrets Risk) -
[CONTEX]*
[ARCH]*
[BRIDGE]*

# ----------------- Temp -------------------
tunnel_output.txt
*.tmp
audit_result.txt
*.bak

# ----------------- OS ---------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ----------------- Agent/Gemini -----------
.agent/

# ----------------- Graphify cache (regenerável) -
graphify-out/cache/
graphify-out/.cache/

# ----------------- Runtime state -----------
state.json

# -----------------------------------------
# Scripts de Desenvolvimento (excluídos)
# Estes são scripts de análise one-off
# -----------------------------------------
analysis.py
audit_*.py
compare_*.py
simulation.py
dashboard.py
database_proposal.py
explicacao_triple_rate.py
post_audit.py

# Manter backtest_from_db.py (ferramenta oficial)
# Manter backtest_gale.py e backtest_techniques.py (referência)
audit_*.txt

